# claude-skills 주간 점검 — 기계 층 (Linux/WSL). macOS 는 같은 디렉터리의 plist 를 쓴다.
#
# 저장소가 아니라 ~/.claude 쪽 사본을 보는 이유는 macOS 와 맞추기 위해서다.
# 그쪽은 ~/Documents 가 TCC 로 보호되어 launchd 가 저장소를 못 읽는다. Linux 엔
# 그 제약이 없지만, 두 컴퓨터가 같은 규약을 쓰는 편이 리포트 위치를 하나로 만든다.
# sync.sh 가 audit.py 와 스킬을 ~/.claude 로 복사한다.

[Unit]
Description=claude-skills 주간 점검 (기계 층)

[Service]
Type=oneshot
WorkingDirectory=%h/.claude/skill-audit
ExecStart=/usr/bin/python3 %h/.claude/skill-audit/audit.py \
  --skills-dir %h/.claude/skills \
  --out %h/.claude/skill-audit/reports \
  --state %h/.claude/skill-audit/state.json
StandardOutput=append:%h/.claude/skill-audit/audit.log
StandardError=append:%h/.claude/skill-audit/audit.log
Nice=10
IOSchedulingClass=idle
